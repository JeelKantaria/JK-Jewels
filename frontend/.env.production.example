# ============================================
# JK JEWELS FRONTEND - PRODUCTION ENVIRONMENT
# ============================================
# Set these in Vercel Dashboard > Project Settings > Environment Variables

# Backend API URL (Render deployment URL)
# Update with your actual Render URL after backend deployment
NEXT_PUBLIC_API_URL=https://jk-jewels-api.onrender.com/api

# Site URL (Vercel auto-sets this, but you can override for custom domain)
NEXT_PUBLIC_SITE_URL=https://jk-jewels.vercel.app

# Razorpay (Optional - for payments)
# NEXT_PUBLIC_RAZORPAY_KEY=rzp_live_your_key_id

# Google Analytics (Optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Feature Flags
NEXT_PUBLIC_ENABLE_REVIEWS=true
NEXT_PUBLIC_ENABLE_WISHLIST=true
